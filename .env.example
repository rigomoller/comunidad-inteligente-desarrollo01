DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-segura
DEBUG=1

# PostgreSQL 14 o superior. El script configurar-postgresql.ps1 crea estas bases.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=comunidad_app
POSTGRES_PASSWORD=cambiar-por-una-clave-postgresql-segura
AUTH_POSTGRES_DB=comunidad_auth
ORGANIZATION_POSTGRES_DB=comunidad_organizacion
POSTGRES_CONN_MAX_AGE=60
POSTGRES_CONNECT_TIMEOUT=5

# Emergencia/pruebas solamente. PostgreSQL es el motor predeterminado.
USE_SQLITE=0

# Asistente IA externo opcional (API compatible con /chat/completions)
AI_API_URL=
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
